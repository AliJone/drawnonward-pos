# set the drawnonward CI environment
DRAWNONWARD_CI_ENV=production
# MySQL/MariaDB and phpMyAdmin username
DRAWNONWARD_MYSQL_USERNAME=admin
# myPhpAdmin admin password
DRAWNONWARD_MYSQL_PASSWORD=pointofsale
# Mysql / MariaDB root passwordS
DRAWNONWARD_MYSQL_ROOT_PASSWORD=drawnonward_mysql
# Set a valid domain name if you use Letsencrypt
DRAWNONWARD_DOMAIN_NAME=pos.example.com
# Set a valid email address if you use Letsencrypt
DRAWNONWARD_CONTACT_EMAIL=info@drawnonward.org
# Set to 1 if you're testing your setup with Letsencrypt
# to avoid hitting request limits, otherwise set 0
DRAWNONWARD_STAGING=1
